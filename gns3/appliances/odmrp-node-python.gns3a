{
  "name": "odmrp-node-python",
  "category": "guest",
  "description": "ODMRP neighbour-UDP agent (python) \u2014 local Docker image",
  "vendor_name": "odmrp-python-prototype",
  "vendor_url": "https://github.com/mowgli42/odmrp-python-prototype",
  "product_name": "odmrp-node-python",
  "registry_version": 3,
  "status": "experimental",
  "maintainer": "mowgli42",
  "usage": "Import after `docker build` of odmrp/node-*:local. Agent impairment off; set delay on GNS3 links.",
  "docker": {
    "adapters": 1,
    "image": "odmrp/node-python:local",
    "console_type": "telnet",
    "extra_hosts": [],
    "environment": [
      "ODMRP_IMPL=python",
      "ODMRP_UNTIL=3600"
    ]
  }
}
